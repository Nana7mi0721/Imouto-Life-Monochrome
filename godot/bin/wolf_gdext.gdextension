[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

windows.debug.x86_64 = "res://bin/wolf_gdext.dll"
windows.release.x86_64 = "res://bin/wolf_gdext.dll"
android.debug.arm64 = "res://bin/android/arm64-v8a/libwolf_gdext.so"
android.release.arm64 = "res://bin/android/arm64-v8a/libwolf_gdext.so"
ios.debug.arm64 = "res://bin/ios/libwolf_gdext.a"
ios.release.arm64 = "res://bin/ios/libwolf_gdext.a"
