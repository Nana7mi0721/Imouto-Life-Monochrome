; Generated by tools/package/render_inno.py. Do not edit the generated copy.

#define MyAppName "@APP_NAME@"
#define MyAppVersion "@APP_VERSION@"
#define MyAppVersion4 "@APP_VERSION4@"
#define MyPublisher "@PUBLISHER@"
#define MyCopyright "@COPYRIGHT@"
#define MySourceDir "@SOURCE_DIR@"
#define MyOutputDir "@OUTPUT_DIR@"
#define MySetupIcon "@SETUP_ICON@"

[Setup]
AppId={{B0B261D2-859A-5D6A-B84D-773056FF5A0A}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyPublisher}
AppPublisherURL=
AppSupportURL=
AppUpdatesURL=
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
OutputDir={#MyOutputDir}
OutputBaseFilename=Imouto Life setup
SetupIconFile={#MySetupIcon}
UninstallDisplayIcon={app}\Imouto Life.exe
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0
CloseApplications=yes
RestartApplications=no
UsePreviousAppDir=yes
AllowNoIcons=yes
ShowLanguageDialog=no
VersionInfoVersion={#MyAppVersion4}
VersionInfoCompany={#MyPublisher}
VersionInfoDescription={#MyAppName} Setup
VersionInfoProductName={#MyAppName}
VersionInfoProductVersion={#MyAppVersion4}
VersionInfoCopyright={#MyCopyright}

[Languages]
Name: "chinesesimp"; MessagesFile: "compiler:Languages\ChineseSimplified.isl"

[Tasks]
Name: "desktopicon"; Description: "创建桌面快捷方式"; GroupDescription: "附加图标："; Flags: unchecked

[Files]
; Keep Data/Save out of the normal replacement pass so reinstalling or
; uninstalling never destroys the player's numbered saves or System.sav.
Source: "{#MySourceDir}\*"; DestDir: "{app}"; \
    Flags: ignoreversion recursesubdirs createallsubdirs; \
    Excludes: "Data\Save\*"
Source: "{#MySourceDir}\Data\Save\System.sav"; DestDir: "{app}\Data\Save"; \
    Flags: onlyifdoesntexist uninsneveruninstall

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\Imouto Life.exe"; WorkingDir: "{app}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\Imouto Life.exe"; WorkingDir: "{app}"; Tasks: desktopicon

[Run]
Filename: "{app}\Imouto Life.exe"; Description: "启动游戏"; \
    Flags: nowait postinstall skipifsilent
